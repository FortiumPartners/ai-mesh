{
  "name": "@fortium/ai-mesh-pane-viewer",
  "version": "0.1.0",
  "description": "Real-time subagent monitoring in terminal panes (WezTerm, Zellij, tmux)",
  "main": "lib/index.js",
  "bin": {
    "ai-mesh-pane-viewer": "hooks/pane-spawner.js"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint hooks/ lib/",
    "lint:fix": "eslint hooks/ lib/ --fix"
  },
  "keywords": [
    "claude-code",
    "plugin",
    "terminal",
    "multiplexer",
    "wezterm",
    "zellij",
    "tmux",
    "monitoring",
    "ai-mesh"
  ],
  "author": {
    "name": "Fortium Partners",
    "email": "support@fortiumpartners.com",
    "url": "https://github.com/FortiumPartners"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FortiumPartners/ai-mesh-pane-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/FortiumPartners/ai-mesh-pane-viewer/issues"
  },
  "homepage": "https://github.com/FortiumPartners/ai-mesh-pane-viewer#readme",
  "devDependencies": {
    "jest": "^29.7.0",
    "eslint": "^8.53.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": ["<rootDir>/tests/setup.js"],
    "collectCoverageFrom": [
      "hooks/**/*.js",
      "lib/**/*.js",
      "!**/node_modules/**",
      "!**/tests/**"
    ]
  }
}
